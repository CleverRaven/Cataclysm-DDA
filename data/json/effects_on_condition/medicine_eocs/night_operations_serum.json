[
  {
    "type": "effect_on_condition",
    "id": "EOC_SERUM_NIGHT_OPS",
    "effect": [
      { "u_consume_item": { "context_val": "id" } },
      { "math": [ "_serum_duration = rng(time('6 h'), time('12 h'))" ] },
      { "math": [ "_serum_duration *= serum_duration_adjustments()" ] },
      { "u_add_effect": "night_ops_serum_main", "duration": { "context_val": "serum_duration" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_APPLY_NIGHT_OPS_SERUM_CRASH",
    "eoc_type": "EVENT",
    "required_event": "character_loses_effect",
    "condition": { "and": [ { "compare_string": [ "night_ops_serum_main", { "context_val": "effect" } ] } ] },
    "effect": [ { "run_eocs": "EOC_APPLY_NIGHT_OPS_SERUM_CRASH_2", "time_in_future": 1 } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_APPLY_NIGHT_OPS_SERUM_CRASH_2",
    "//": "This is necessary because character_loses_effect triggers before the effect is actually removed",
    "effect": [
      { "u_add_effect": "night_ops_serum_crash", "duration": [ "2 h", "4 h" ] },
      { "run_eocs": "EOC_NIGHT_OPS_SERUM_CRASH_RANDOM_NYCTOPHOBIA", "time_in_future": [ "20 minutes", "2 hours" ] }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_NIGHT_OPS_SERUM_CRASH_RANDOM_NYCTOPHOBIA",
    "condition": { "u_has_effect": "night_ops_serum_crash" },
    "effect": [
      {
        "if": { "and": [ { "x_in_y_chance": { "x": 1, "y": 2 } }, { "not": { "u_has_effect": "betablock" } } ] },
        "then": { "u_add_effect": "night_ops_serum_crash_nyctophobia", "duration": [ "30 minutes", "1 hours" ] }
      },
      { "run_eocs": "EOC_NIGHT_OPS_SERUM_CRASH_RANDOM_NYCTOPHOBIA", "time_in_future": [ "20 minutes", "2 hours" ] }
    ]
  },
  {
    "type": "effect_type",
    "id": "night_ops_serum_main",
    "name": [ "Injected 09x-\"Anaximander\"" ],
    "desc": [ "You just took a shot of that strange vial you found.  The shadows don't seem so dark anymore." ],
    "apply_message": "Without hesitation, you draw the liquid from the ampule, smack it a bit to release any air, and inject it right into a vein, hoping it won't kill you.",
    "remove_message": "The darkness returns to impenetrability.",
    "rating": "mixed",
    "max_intensity": 100,
    "int_add_val": 1,
    "show_intensity": false,
    "dur_add_perc": 5,
    "removes_effects": [ "night_ops_serum_crash" ],
    "base_mods": {
      "perspiration_min": [ 1 ],
      "perspiration_tick": [ 300 ],
      "perspiration_chance": [ 6 ],
      "vomit_chance": [ 50 ],
      "vomit_tick": [ 300 ]
    },
    "enchantments": [
      {
        "values": [
          { "value": "NIGHT_VIS", "add": 20 },
          { "value": "HEARING_MULT", "multiply": 1 },
          { "value": "MAX_STAMINA", "multiply": 1 },
          { "value": "SLEEPINESS", "multiply": -1 },
          { "value": "STAMINA_REGEN_MOD", "add": -0.45 },
          { "value": "THIRST", "multiply": 0.2 },
          { "value": "SCENT_MASK", "add": 350 }
        ]
      },
      {
        "condition": { "math": [ "u_val('fine_detail_vision_mod') >= 4" ] },
        "values": [ { "value": "STEALTH_MODIFIER", "add": 50 } ]
      },
      { "condition": { "not": "is_day" }, "values": [ { "value": "OVERMAP_SIGHT", "add": 6 } ] }
    ],
    "limb_score_mods": [ { "limb_score": "breathing", "modifier": 0.9 } ],
    "//": "Mute is supposed to represent acute laryngitis.  Allowing communication through whispering would be better",
    "flags": [ "EFFECT_LIMB_SCORE_MOD", "MYOPIC_IN_LIGHT", "MUTE" ]
  },
  {
    "type": "effect_type",
    "id": "night_ops_serum_crash",
