[
  {
    "type": "effect_on_condition",
    "id": "EOC_SERUM_LEARNING",
    "effect": [
      { "u_consume_item": { "context_val": "id" } },
      { "math": [ "_serum_duration = rng(time('12 h'), time('24 h'))" ] },
      { "u_add_effect": "learning_serum_main", "duration": { "context_val": "serum_duration" } },
      {
        "if": { "math": [ "u_effect_intensity('learning_serum_main') <= 1" ] },
        "then": { "run_eocs": "EOC_SERUM_LEARNING_HALLUCINATION_CHANCE", "time_in_future": [ "30 minutes", "90 minutes" ] }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_APPLY_LEARNING_SERUM_CRASH",
    "eoc_type": "EVENT",
    "required_event": "character_loses_effect",
    "condition": { "and": [ { "compare_string": [ "learning_serum_main", { "context_val": "effect" } ] } ] },
    "effect": [ { "run_eocs": "EOC_APPLY_LEARNING_SERUM_CRASH_2", "time_in_future": 1 } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_APPLY_LEARNING_SERUM_CRASH_2",
    "//": "This is necessary because character_loses_effect triggers before the effect is actually removed",
    "effect": { "u_add_effect": "learning_serum_crash", "duration": [ "3 h", "6 h" ] }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SERUM_LEARNING_HALLUCINATION_CHANCE",
    "condition": { "u_has_any_effect": [ "learning_serum_main", "learning_serum_crash" ] },
    "effect": [
      {
        "switch": { "math": [ "rand(3)" ] },
        "cases": [
          {
            "case": 3,
            "effect": [ { "u_add_effect": "resilience_serum_side_effect_hallucinations", "duration": { "math": [ "1800 + rand(1800)" ] } } ]
          }
        ]
      },
      { "run_eocs": "EOC_SERUM_LEARNING_HALLUCINATION_CHANCE", "time_in_future": [ "30 minutes", "90 minutes" ] }
    ]
  },
  {
    "type": "effect_type",
    "id": "learning_serum_main",
    "name": [ "Injected 76x-\"Lore\"" ],
    "desc": [
      "You just took a shot of some weird stuff.  You feel sleepy, nauseous, and generally weak, but your wounds are closing up at an unnatural pace."
    ],
    "apply_message": "Without hesitation, you draw the liquid from the ampule, smack it a bit to release any air, and inject it right into a vein, hoping it won't kill you.",
    "remove_message": "Your thoughts slow gradually.",
    "rating": "mixed",
    "max_intensity": 100,
    "int_add_val": 1,
    "show_intensity": false,
    "dur_add_perc": 10,
    "removes_effects": [ "learning_serum_crash" ],
    "enchantments": [
      {
        "values": [
          { "value": "PERCEPTION", "add": { "math": [ "3 + min( (u_effect_intensity('learning_serum_main') ), 5)" ] } },
          { "value": "LEARNING_FOCUS", "add": { "math": [ "u_val('focus') < 60 ? ( 60 - u_val('focus') ) : 0" ] } },
          {
            "value": "THEORETICAL_SKILL_CATCHUP_BONUS",
            "multiply": { "math": [ "0.5 + min( (u_effect_intensity('learning_serum_main') * 0.1 ), 1)" ] }
          },
          { "value": "READING_SPEED_MULTIPLIER", "multiply": -0.2 },
          { "value": "SLEEPY", "add": -1000 },
          { "value": "METABOLISM", "multiply": 0.2 }
        ]
      },
      {
        "condition": { "and": [ { "not": { "u_has_worn_with_flag": "SUN_GLASSES" } }, { "and": [ "u_is_outside", "is_day" ] } ] },
        "ench_effects": [ { "effect": "learning_serum_light_pain", "intensity": 1 } ]
      },
      {
        "condition": {
          "and": [
            {
              "math": [
                "(u_monsters_nearby('radius': 35, 'attitude': 'hostile') + u_characters_nearby('radius': 35, 'attitude': 'not_allies') ) > 0"
              ]
            }
          ]
        },
        "intermittent_activation": {
          "effects": [
            { "frequency": "7 seconds", "spell_effects": [ { "id": "learning_serum_time_slow_perception_spell" } ] },
            { "frequency": "19 seconds", "spell_effects": [ { "id": "learning_serum_time_slow_perception_spell" } ] }
          ]
        }
      },
      {
        "condition": {
          "and": [
            {
              "math": [
                "(u_monsters_nearby('radius': 35, 'attitude': 'hostile') + u_characters_nearby('radius': 35, 'attitude': 'not_allies') ) > 0"
              ]
            },
            { "math": [ "u_effect_intensity('learning_serum_main') >= 3" ] }
          ]
        },
        "intermittent_activation": {
          "effects": [ { "frequency": "13 seconds", "spell_effects": [ { "id": "learning_serum_time_slow_perception_spell" } ] } ]
        }
      }
    ],
    "flags": [ "MYOPIC_IN_LIGHT", "CANNOT_SLEEP" ]
  },
  {
    "type": "effect_type",
    "id": "learning_serum_crash",
    "name": [ "Injected Serum Crash" ],
    "desc": [ "Your enhanced focus has faded away, light seems too bright, and you're pretty tired." ],
    "apply_message": "",
    "remove_message": "",
    "enchantments": [
      { "values": [ { "value": "SLEEPINESS", "multiply": 0.25 }, { "value": "LEARNING_FOCUS", "add": -25 } ] },
      {
        "condition": { "and": [ { "not": { "u_has_worn_with_flag": "SUN_GLASSES" } }, { "and": [ "u_is_outside", "is_day" ] } ] },
        "ench_effects": [ { "effect": "learning_serum_light_pain", "intensity": 1 } ]
      }
    ],
    "flags": [ "MYOPIC_IN_LIGHT" ]
  },
  {
    "type": "effect_type",
    "id": "learning_serum_light_pain",
    "name": [ "" ],
    "desc": [ "" ],
    "apply_message": "",
    "remove_message": "",
    "base_mods": { "pain_min": [ 1 ], "pain_max": [ 3 ], "pain_max_val": [ 25 ], "pain_chance": [ 4 ], "pain_tick": [ 120 ] }
  },
  {
    "id": "learning_serum_time_slow_perception_spell",
    "type": "SPELL",
    "name": { "str": "Lore Serum Slow Time", "//~": "NO_I18N" },
    "description": { "str": "Applies the time slow effect from the Lore Serum.", "//~": "NO_I18N" },
    "message": "",
    "valid_targets": [ "self" ],
    "effect": "effect_on_condition",
    "effect_str": "EOC_LEARNING_SERUM_SLOW_TIME_EFFECT",
    "shape": "blast",
    "flags": [ "NO_EXPLOSION_SFX" ],
    "base_casting_time": 100
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_LEARNING_SERUM_SLOW_TIME_EFFECT",
    "condition": { "and": [ { "x_in_y_chance": { "x": 1, "y": 5 } }, { "not": { "u_has_effect": "regen_serum_slow_time" } } ] },
    "effect": [ { "u_add_effect": "regen_serum_slow_time", "duration": [ "3 s", "10 s" ] } ]
  },
  {
    "type": "effect_type",
    "id": "regen_serum_slow_time",
    "name": [ "Slowed Time" ],
    "desc": [ "Everything around you seems to be moving slower." ],
    "apply_message": "Everything seems to suddenly slow down!",
    "remove_message": "The world around you speeds up.",
    "rating": "good",
    "enchantments": [ { "values": [ { "value": "AIMING_SPEED", "multiply": 0.25 }, { "value": "ATTACK_SPEED", "multiply": -0.25 } ] } ]
  }
]
