      {
        "condition": { "math": [ "u_pain('type': 'perceived') <= 40" ] },
        "values": [ { "value": "BONUS_BLOCK", "add": 1 }, { "value": "BONUS_DODGE", "add": 1 } ]
      }
    ]
  },
  {
    "type": "effect_type",
    "id": "speed_serum_crash",
    "name": [ "Injected Serum Crash" ],
