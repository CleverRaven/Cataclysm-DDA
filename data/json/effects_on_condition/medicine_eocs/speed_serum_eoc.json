[
  {
    "type": "effect_on_condition",
    "id": "EOC_SERUM_SPEED",
    "effect": [
      { "u_consume_item": { "context_val": "id" } },
      { "math": [ "_serum_duration = rng(time('3 d'), time('6 d'))" ] },
      { "u_add_effect": "speed_serum_main", "duration": { "context_val": "serum_duration" } },
      { "run_eocs": "EOC_APPLY_SPEED_SERUM_CRASH", "time_in_future": { "context_val": "serum_duration" } },
      {
        "if": { "math": [ "u_effect_intensity('speed_serum_main') <= 1" ] },
        "then": { "run_eocs": "EOC_SERUM_SPEED_PERIODIC_SIDE_EFFECTS", "time_in_future": [ "25 minutes", "65 minutes" ] }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_APPLY_SPEED_SERUM_CRASH",
    "condition": { "not": { "u_has_effect": "speed_serum_crash" } },
    "effect": [ { "run_eocs": "EOC_APPLY_SPEED_SERUM_CRASH_2", "time_in_future": 1 } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_APPLY_SPEED_SERUM_CRASH_2",
    "//": "This is necessary because character_loses_effect triggers before the effect is actually removed",
    "effect": [ { "u_add_effect": "speed_serum_crash", "duration": [ "1 d", "2 d" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SERUM_SPEED_PERIODIC_SIDE_EFFECTS",
    "condition": { "u_has_effect": "speed_serum_main" },
    "effect": [
      { "run_eocs": "EOC_SERUM_SPEED_PERIODIC_SIDE_EFFECTS", "time_in_future": [ "25 minutes", "65 minutes" ] },
      {
        "if": { "not": { "u_has_effect": "valium" } },
        "then": {
          "switch": { "math": [ "rand(5)" ] },
          "cases": [
            {
              "case": 4,
              "effect": {
                "if": {
                  "and": [
                    "u_has_weapon",
                    { "not": { "u_has_effect": "sleep" } },
                    {
                      "math": [
                        "(u_limb_score('grip', 'type': 'hand') + (rand(u_val('dexterity') ) * 0.1) + (u_has_trait('CLUMSY') * -0.2) + (u_effect_intensity('shakes') > -1 ? -0.2 : 0) + (u_has_trait('DEFT') * 0.1) ) < 0.6"
                      ]
                    }
                  ]
                },
                "then": [
                  { "u_add_effect": "effect_zero_manip", "duration": 0 },
                  { "u_message": "Your hands suddenly twitch, releasing your grip!", "type": "bad" }
                ]
              }
            },
            {
              "case": 5,
              "effect": {
                "if": {
                  "and": [
                    { "not": { "u_has_effect": "sleep" } },
                    {
                      "math": [
                        "(u_limb_score('balance') + (rand(u_val('dexterity') ) * 0.1) + (u_has_trait('BADKNEES') * -0.1) + (u_has_trait('REALLYBADKNEES') * -0.4) ) < 0.6"
                      ]
                    }
                  ]
                },
                "then": [
                  { "u_add_effect": "downed", "duration": 5 },
                  { "u_message": "Your legs twitch and you fall to the ground!", "type": "bad" }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "type": "effect_type",
    "id": "speed_serum_main",
    "name": [ "Injected 51x-\"Landru\"" ],
    "desc": [ "You just took a shot of that strange vial you found.  Time seems to have slowed down." ],
    "apply_message": "Without hesitation, you draw the liquid from the ampule, smack it a bit to release any air, and inject it right into a vein, hoping it won't kill you.",
    "remove_message": "The world around you speeds up.",
    "rating": "mixed",
    "max_intensity": 100,
    "int_add_val": 1,
    "show_intensity": false,
    "dur_add_perc": 10,
    "removes_effects": [ "speed_serum_crash" ],
