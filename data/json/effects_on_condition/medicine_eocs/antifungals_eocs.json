[
{
    "type": "effect_on_condition",
    "id": "EOC_CONSUMED_ANTIFUNGAL",
    "effect": [ 
	{ "u_add_effect": "antifungal", "duration": "16 hours" }, 
	{ "u_message": "You take an antifungal.", "type": "info" },
	{ 
		"if": { "u_has_effect": "fungus_infection" },
		"then": { "run_eocs": "EOC_ANTIFUNGAL_CHANCE", "time_in_future": "20 minutes" },
		"else": { "u_message": "", "type": "info" }
	}
	]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_ANTIFUNGAL_CHANCE",
	"condition": { "and": [ { "u_has_effect": "fungus" }, { "x_in_y_chance": { "x": 1, "y": { "math": [ "2 * u_effect_intensity('fungus') + 1" ] } } } ] },
    "effect": [
	{
		"if": { "math": [ "u_effect_intensity('fungus_infection') >= 2" ] },
		"then": [
		{ "u_message": "The fungal infection is calmed, but not removed.  Perhaps you need something stronger.", "type": "mixed" },
		{ "u_add_effect": "fungus_infection", "intensity": 2, "duration": "PERMANENT" }
		],
		"else": {
		"if": { "math": [ "u_effect_intensity('fungus_infection') == 1" ] },
		"then": [
				{ "u_lose_effect": "fungus_infection" },
				{ "u_message": "The fungal infection is wiped from your body.", "type": "good" } 
		],
		"else": {
			"if": { "math": [ "u_effect_intensity('fungus_infection') < 2" ] },
			"then": [
					{ "u_add_effect": "fungus_infection", "intensity": { "math": [ "u_effect_intensity('fungus_infection') == 1" ] }, "duration": "PERMANENT" },
					{ "u_message": "The fungal infection is slightly quelled.", "type": "good" } 
		]
		}
	}
	}
    ],
	"false_effect": { "u_message": "The antifungal pills didn't work.", "type": "bad" }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_CONSUMED_ANTIFUNGAL_STRONG",
    "effect": [ 
	{ "u_add_effect": "antifungal", "duration": "16 hours" }, 
	{ "u_message": "You take a strong antifungal.", "type": "info" },
	{ 
		"if": { "u_has_effect": "fungus_infection" },
		"then": { "run_eocs": "EOC_ANTIFUNGAL_CHANCE_STRONG", "time_in_future": "20 minutes" },
		"else": { "u_message": "", "type": "info" }
	}
	]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_ANTIFUNGAL_CHANCE_STRONG",
    "effect": [
	{
		"if": {
		"and": [
		{ "x_in_y_chance": { "x": 1, "y": { "math": [ "u_effect_intensity('fungus_infection') + 1" ] } } },
		{ "math": [ "u_effect_intensity('fungus_infection') > 2" ] } 
		]
		},
		"then": [
		{ "u_add_effect": "fungus_infection", "intensity": { "math": [ "u_effect_intensity('fungus_infection') - 2" ] }, "duration": "PERMANENT" },
		{ "u_message": "The fungal infection is heavily quelled.", "type": "good" } 
		],
		"else": [
		{ "u_lose_effect": "fungus_infection" },
		{ "u_message": "The fungal infection is wiped from your body." }
		]
	}
    ]
  }
]
