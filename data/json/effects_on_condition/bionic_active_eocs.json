      { "if": { "math": [ "u_vitamin('redcells') < -1" ] }, "then": { "math": [ "u_vitamin('redcells') += 2" ] } },
      { "if": { "math": [ "u_vitamin('blood') < -1" ] }, "then": { "math": [ "u_vitamin('blood') += 2" ] } }
    ]
