[
  {
    "id": "MISSION_REACH_GLASS_EXIT",
    "type": "mission_definition",
    "name": { "str": "Reach the breach point" },
    "goal": "MGOAL_GO_TO",
    "description": "Maybe if you followed the faint glow, you'll find the same exit the 'thing' used.",
    "difficulty": 0,
    "value": 0,
    "invisible_on_complete": true,
    "start": { "assign_mission_target": { "var": { "global_val": "glass_breach" } } }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_EXIT_nether_glass_into_lab",
    "condition": { "current_dimension": "abyss" },
    "effect": [
      {
        "u_travel_to_dimension": "default",
        "npc_travel_radius": 40,
        "npc_travel_filter": "follower",
        "fail_message": "Nothing seems to change.",
        "success_message": ""
      },
      {
        "u_location_variable": { "global_val": "microlab_portal_elevator_nether_glass" },
        "target_params": { "om_terrain": "microlab_portal_elevator_nether_glass", "z": -10, "min_distance": 1 }
      },
      { "u_teleport": { "global_val": "microlab_portal_elevator_nether_glass" }, "force": true },
      {
        "mapgen_update": "microlab_portal_elevator_physics_shift",
        "om_terrain": "microlab_portal_elevator_physics_glass"
      },
      { "clear_dimension": { "u_val": "abyss" } }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_nether_glass_event",
    "//": "Needs obsoletion due to effects being converted from a recurring effect",
    "effect": [  ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_nether_glass_event_om",
    "effect": [
      {
        "if": { "and": [ { "x_in_y_chance": { "x": 1, "y": 5 } }, { "not": { "current_dimension": "abyss" } } ] },
        "then": [
          {
            "u_travel_to_dimension": "abyss",
            "npc_travel_radius": 0,
            "npc_travel_filter": "none",
            "fail_message": "Something is very wrong!",
            "success_message": ""
          },
          { "u_location_variable": { "context_val": "tp_loc" }, "z_adjust": -10, "z_override": true },
          { "u_teleport": { "context_val": "tp_loc" } }
        ],
        "else": [
          {
            "run_eocs": [
              {
                "id": "EOC_nether_glass_yrax_encounter",
                "condition": { "and": [ { "x_in_y_chance": { "x": 1, "y": 100 } } ] },
                "effect": [
                  { "u_add_var": "general_yrax_u_met_apeirohedra", "value": "yes" },
                  { "run_eocs": [ "capture_generic_nre_anomaly" ] },
                  {
                    "u_spawn_monster": "mon_yrax_apeirogon",
                    "real_count": 1,
                    "min_radius": 3,
                    "max_radius": 10,
                    "lifespan": [ "40 seconds", "2 minutes" ],
                    "spawn_message": "The emptiness yields before an all-encompassing construct.",
                    "spawn_message_plural": "Reality twists and deforms as wriggling chunks of it fall on the ground."
                  },
                  {
                    "u_spawn_monster": "mon_yrax_trifacet",
                    "real_count": 15,
                    "min_radius": 3,
                    "max_radius": 20,
                    "lifespan": [ "40 seconds", "2 minutes" ]
                  },
                  {
                    "if": { "mod_is_loaded": "mindovermatter" },
                    "then": { "run_eocs": "EOC_MOM_FIFTH_SUN_ON_SEEING_YRAX_APEIROHEDRON" }
                  }
                ]
              },
              {
                "id": "EOC_nether_glass_reveal_exit",
                "condition": { "and": [ { "x_in_y_chance": { "x": 1, "y": 25 } }, { "not": { "u_has_mission": "MISSION_REACH_GLASS_EXIT" } } ] },
                "effect": [
                  {
                    "u_location_variable": { "global_val": "glass_breach" },
                    "target_params": {
                      "om_terrain": "nether_glass_exit_north",
                      "om_terrain_replace": "nether_glass_deep",
                      "z": -10,
                      "random": true,
                      "min_distance": 6,
                      "search_range": 130
                    }
                  },
                  {
                    "u_message": "Far away, a large mass moves through the emptiness, and vanishes.  A faint glow remains in the point where it pierced through.",
                    "popup": true
                  },
                  { "assign_mission": "MISSION_REACH_GLASS_EXIT" }
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_MOM_FIFTH_SUN_ON_SEEING_YRAX_APEIROHEDRON",
    "effect": [  ]
  }
]
