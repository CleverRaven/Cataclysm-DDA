    "id": "EOC_REGEN_MUTATIONS_CLEANING_WOUNDS_EFFECTS",
    "condition": { "expects_vars": [ "bodypart" ] },
    "effect": [
      {
        "if": { "u_has_body_part": { "context_val": "bodypart" } },
        "then": [
          {
            "if": { "u_has_any_wound": [ "scratch_bad" ], "bodypart": { "context_val": "bodypart" } },
            "then": [
              { "u_remove_wound": { "context_val": "bodypart" }, "wound_id": [ "scratch_bad" ] },
              { "u_add_wound": { "context_val": "bodypart" }, "wound_id": "clean_scratch_bad" }
            ]
          },
          {
