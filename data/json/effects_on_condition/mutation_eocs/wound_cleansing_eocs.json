[
  {
    "type": "effect_on_condition",
    "id": "EOC_EATHEALTH_activated",
    "effect": { "math": [ "u_eathealth_counter = 0" ] }
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_EATHEALTH_processed",
    "effect": [
      { "if": { "math": [ "u_eathealth_counter > 60" ] }, "then": { "math": [ "u_eathealth_counter = 0" ] } },
      {
        "if": {
          "and": [
            { "one_in_chance": 4 },
            { "or": [ { "math": [ "u_eathealth_counter == 15" ] }, { "math": [ "u_eathealth_counter == 45" ] } ] }
          ]
        },
        "then": [
          {
            "foreach": "ids",
            "target": "bodypart",
            "var": { "context_val": "bodypart" },
            "effect": [
              {
                "run_eocs": "EOC_REGEN_MUTATIONS_STOP_BLEEDING_WOUNDS_EFFECTS",
                "variables": { "bodypart": { "context_val": "bodypart" } }
              }
            ]
          }
        ]
      },
      {
        "if": { "and": [ { "one_in_chance": 5 }, { "math": [ "u_eathealth_counter == 60" ] } ] },
        "then": [
          {
            "if": {
              "and": [
                { "one_in_chance": 10 },
                { "not": { "u_has_any_trait": [ "INFRESIST", "INFIMMUNE" ] } },
                { "not": { "u_has_any_trait": [ "DISRESISTANT", "DISIMMUNE" ] } }
              ]
            },
            "then": {
              "foreach": "ids",
              "target": "bodypart",
              "var": { "context_val": "bodypart" },
              "effect": [
                {
                  "run_eocs": "EOC_REGEN_MUTATIONS_CLEANING_WOUNDS_EFFECTS",
                  "variables": { "bodypart": { "context_val": "bodypart" } }
                }
              ]
            }
          },
          {
            "if": {
              "and": [
                { "one_in_chance": 3 },
                { "or": [ { "u_has_any_trait": [ "INFRESIST", "INFIMMUNE" ] }, { "u_has_trait": "DISRESISTANT" } ] }
              ]
            },
            "then": {
              "foreach": "ids",
              "target": "bodypart",
              "var": { "context_val": "bodypart" },
              "effect": [
                {
                  "run_eocs": "EOC_REGEN_MUTATIONS_CLEANING_WOUNDS_EFFECTS",
                  "variables": { "bodypart": { "context_val": "bodypart" } }
                }
              ]
            }
          },
          {
            "if": {
              "and": [
                { "x_in_y_chance": { "x": 2, "y": 3 } },
                {
                  "or": [
                    { "and": [ { "u_has_any_trait": [ "INFRESIST", "INFIMMUNE" ] }, { "u_has_trait": "DISRESISTANT" } ] },
                    {
                      "and": [ { "not": { "u_has_any_trait": [ "INFRESIST", "INFIMMUNE" ] } }, { "u_has_trait": "DISIMMUNE" } ]
                    }
                  ]
                }
              ]
            },
            "then": {
              "foreach": "ids",
              "target": "bodypart",
              "var": { "context_val": "bodypart" },
              "effect": [
                {
                  "run_eocs": "EOC_REGEN_MUTATIONS_CLEANING_WOUNDS_EFFECTS",
                  "variables": { "bodypart": { "context_val": "bodypart" } }
                }
              ]
            }
          },
          {
            "if": { "and": [ { "u_has_any_trait": [ "INFRESIST", "INFIMMUNE" ] }, { "u_has_trait": "DISIMMUNE" } ] },
            "then": {
              "foreach": "ids",
              "target": "bodypart",
              "var": { "context_val": "bodypart" },
              "effect": [
                {
                  "run_eocs": "EOC_REGEN_MUTATIONS_CLEANING_WOUNDS_EFFECTS",
                  "variables": { "bodypart": { "context_val": "bodypart" } }
                }
              ]
            }
          }
        ]
      },
      { "math": [ "u_eathealth_counter ++" ] }
    ]
  },
