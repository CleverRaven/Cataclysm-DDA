          { "math": [ "_temp_healing_pool = _healing_pool - 14" ] },
          {
            "if": { "math": [ "rng(0,1) <= (_temp_healing_pool / 11)" ] },
            "then": [
              { "u_remove_wound": { "context_val": "bodypart" }, "wound_id": [ "bleeding_laceration_bad" ] },
              { "math": [ "_healing_pool -= 25" ] }
