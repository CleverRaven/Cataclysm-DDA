[
  {
    "//": "Calculates healing based on the damage required to cause the wound.  All bleeding wounds first, in order of severity, then all other wounds, in order of severity.  No broken bones.",
    "type": "effect_on_condition",
    "id": "EOC_GENERIC_SUPERNATURAL_WOUND_HEALING",
    "condition": { "expects_vars": [ "bodypart", "minimum_healing_threshold", "maximum_healing_threshold" ] },
    "effect": [
      { "math": [ "_healing_threshold = rng(-minimum_healing_threshold, -maximum_healing_threshold)" ] },
      {
        "//": "Range 20-60",
        "if": {
          "and": [
            { "u_has_any_wound": [ "bleeding_cut_bad" ], "bodypart": { "context_val": "bodypart" } },
            { "math": [ "_healing_threshold >= 15" ] }
          ]
        },
        "then": [
          { "math": [ "_temp_healing_threshold = _healing_threshold - 19" ] },
          {
            "if": { "math": [ "rng(0,1) <= (_temp_healing_threshold / 41)" ] },
            "then": [
              { "u_remove_wound": { "context_val": "bodypart" }, "wound_id": [ "bleeding_cut_bad" ] },
              { "math": [ "_healing_threshold -= 60" ] }
            ]
          }
        ]
      },
      {
        "//": "Range 15-25",
        "if": {
          "and": [
            { "u_has_any_wound": [ "bleeding_laceration_bad" ], "bodypart": { "context_val": "bodypart" } },
            { "math": [ "_healing_threshold >= 15" ] }
          ]
        },
        "then": [
          { "math": [ "_temp_healing_threshold = _healing_threshold - 14" ] },
          {
            "if": { "math": [ "rng(0,1) <= (_temp_healing_threshold / 11)" ] },
            "then": [
              { "u_remove_wound": { "context_val": "bodypart" }, "wound_id": [ "bleeding_laceration_bad" ] },
              { "math": [ "_healing_threshold -= 25" ] }
            ]
          }
        ]
      },
      {
        "//": "Range 15-20",
        "if": {
          "and": [
            { "u_has_any_wound": [ "bleeding_scratch_bad" ], "bodypart": { "context_val": "bodypart" } },
            { "math": [ "_healing_threshold >= 15" ] }
          ]
        },
        "then": [
          { "math": [ "_temp_healing_threshold = _healing_threshold - 14" ] },
          {
            "if": { "math": [ "rng(0,1) <= (_temp_healing_threshold / 6)" ] },
