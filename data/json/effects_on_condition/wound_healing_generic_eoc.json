    "//": "Calculates healing based on the damage required to cause the wound.  All bleeding wounds first, in order of severity, then all other wounds, in order of severity.  No broken bones.",
    "type": "effect_on_condition",
    "id": "EOC_GENERIC_SUPERNATURAL_WOUND_HEALING",
    "condition": { "expects_vars": [ "bodypart", "minimum_healing_pool", "maximum_healing_pool" ] },
    "effect": [
      { "math": [ "_healing_pool = rng(_minimum_healing_pool, _maximum_healing_pool)" ] },
      {
        "//": "Range 20-60",
        "if": {
          "and": [
            { "u_has_any_wound": [ "bleeding_cut_bad" ], "bodypart": { "context_val": "bodypart" } },
            { "math": [ "_healing_pool >= 20" ] }
          ]
        },
        "then": [
          { "math": [ "_temp_healing_pool = _healing_pool - 19" ] },
          {
            "if": { "math": [ "rng(0,1) <= (_temp_healing_pool / 41)" ] },
            "then": [
              { "u_remove_wound": { "context_val": "bodypart" }, "wound_id": [ "bleeding_cut_bad" ] },
              { "math": [ "_healing_pool -= 60" ] }
            ]
          }
        ]
      },
      {
        "//": "Range 15-25",
