    "description": "Something is there.  It is something you touched.",
    "color": "black",
    "required_str": -1,
    "move_cost_mod": -1,
    "examine_action": { "type": "effect_on_condition", "effect_on_conditions": [ "EOC_PORTAL_DUNGEON_REWARD_INCREASER_CLAIMED" ] }
  },
  {
    "id": "EOC_PORTAL_DUNGEON_REWARD_INCREASER_CLAIMED",
    "type": "effect_on_condition",
    "effect": [ { "u_message": "It is forever inert.  You should find another.", "type": "info" } ]
