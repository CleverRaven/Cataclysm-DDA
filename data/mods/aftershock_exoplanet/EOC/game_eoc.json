[
  {
    "type": "effect_on_condition",
    "id": "EOC_START_SHIELD_UI",
    "eoc_type": "EVENT",
    "required_event": "game_start",
    "effect": [ { "math": [ "u_shield_ratio = -1" ] } ]
  },
  {
    "id": "EOC_AFS_LEADERSHIP_SWITCH",
    "type": "effect_on_condition",
    "eoc_type": "AVATAR_DEATH",
    "condition": {
      "and": [
        { "npc_allies_global": 1 },
        { "math": [ "afs_leadership_act == 1" ] },
        { "u_query": "You have died.  Continue as one of your followers?", "default": false }
      ]
    },
    "effect": [ "take_control_menu" ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_return_to_partyleader",
    "effect": [
      {
        "run_eocs": {
          "id": "_EOC_return_to_partyleader_do",
          "effect": [ "follow", { "math": [ "afs_leadership_act = 0" ] }, "take_control" ]
        },
        "alpha_talker": "avatar",
        "beta_talker": { "global_val": "party_leader_id" },
        "false_eocs": { "id": "_EOC_return_to_partyleader_fail_msg", "effect": { "message": "Unable to locate the party leader." } }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "SMARTLINK_EXTRA_SHOT_MON",
    "eoc_type": "EVENT",
    "required_event": "character_ranged_attacks_monster",
    "condition": {
      "and": [
        { "u_has_wielded_with_skill": "smartgun" },
        { "u_is_wearing": "afs_headset_smartlink" },
        { "not": { "u_has_effect": "vahagan_fired_at" } }
      ]
    },
    "effect": [ { "run_eocs": [ "SMARTLINK_EXTRA_SHOT" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "SMARTLINK_EXTRA_SHOT_CHAR",
    "eoc_type": "EVENT",
    "required_event": "character_ranged_attacks_character",
    "condition": {
      "and": [
        { "u_has_wielded_with_skill": "smartgun" },
        { "u_is_wearing": "afs_headset_smartlink" },
        { "not": { "u_has_effect": "vahagan_fired_at" } }
      ]
    },
    "effect": [ { "run_eocs": [ "SMARTLINK_EXTRA_SHOT" ] } ]
  },
  {
    "type": "effect_on_condition",
    "id": "SMARTLINK_EXTRA_SHOT",
    "effect": [
      { "u_add_effect": "vahagan_fired_at", "duration": "1 seconds" },
      { "math": [ "times_firing_extra = 0" ] },
      { "u_location_variable": { "context_val": "shooter" } },
      {
        "u_run_monster_eocs": [
          {
            "id": "_smartlink_shootfoes",
            "condition": {
              "and": [
                { "u_has_effect": "smart_targeted" },
                { "math": [ "u_hp('ALL') > 1" ] },
                { "math": [ "times_firing_extra < 1" ] },
                { "not": { "u_has_effect": "vahagan_fired_at" } }
              ]
            },
            "effect": [
              { "u_add_effect": "vahagan_fired_at", "duration": "1 seconds" },
              { "u_lose_effect": "smart_targeted" },
              { "math": [ "times_firing_extra++" ] },
              {
                "run_eocs": [ "EOC_vahagn_shootfoes" ],
                "alpha_loc": { "context_val": "shooter" },
                "beta_talker": "u"
              }
            ]
          }
        ],
        "monster_range": 45,
        "monster_must_see": true
      },
      { "math": [ "times_firing_extra = 0" ] }
    ]
  }
]
