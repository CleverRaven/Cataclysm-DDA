    "shape": "blast",
    "min_range": 1,
    "max_range": 1,
    "message": "",
    "effect": "effect_on_condition",
    "effect_str": "EOC_SOABOSAURUS_CONTROL"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_SOABOSAURUS_CONTROL",
    "effect": [
      {
        "run_eocs": [
          {
            "id": "eoc_start_update_soabosaurus",
            "condition": { "math": [ "updating_soabosaurus != 1" ] },
            "effect": [ { "run_eocs": "eoc_update_soabosaurus" } ]
          },
          {
            "id": "soabosaurus_setup",
            "condition": { "math": [ "u_setup != 1" ] },
            "effect": [
              { "math": [ "_skauropod_uid = rand(1200)" ] },
              { "math": [ "u_skauropod_uid = _skauropod_uid" ] },
              { "math": [ "u_setup = 1" ] },
              { "u_spawn_monster": "mon_skauropod_leg", "real_count": 4, "min_radius": 1, "max_radius": 1 },
              {
                "u_run_monster_eocs": [ { "id": "soabosaurus_leg_assign", "effect": [ { "math": [ "u_skauropod_id = _skauropod_uid" ] } ] } ],
                "monster_range": 2,
                "mtype_ids": [ "mon_skauropod_leg" ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "eoc_update_soabosaurus",
    "type": "effect_on_condition",
    "global": true,
    "condition": { "math": [ "u_monsters_nearby('mon_soabosaurus', 'radius': 3) >= 1" ] },
    "effect": [
      { "math": [ "updating_soabosaurus = 1" ] },
      { "run_eocs": "eoc_update_soabosaurus", "time_in_future": 1 },
      { "u_run_monster_eocs": [ "eoc_skauropod" ], "monster_range": 3, "mtype_ids": [ "mon_soabosaurus" ] }
    ],
    "false_effect": [ { "math": [ "updating_soabosaurus = 0" ] } ]
  },
