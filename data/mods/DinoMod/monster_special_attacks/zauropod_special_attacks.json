    "shape": "blast",
    "min_range": 1,
    "max_range": 1,
    "message": "",
    "effect": "effect_on_condition",
    "effect_str": "EOC_ZOABOSAURUS_CONTROL"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_ZOABOSAURUS_CONTROL",
    "effect": [
      {
        "run_eocs": [
          {
            "id": "eoc_start_update_zoabosaurus",
            "condition": { "math": [ "updating_zoabosaurus != 1" ] },
            "effect": [ { "run_eocs": "eoc_update_zoabosaurus" } ]
          },
          {
            "id": "zoabosaurus_setup",
            "condition": { "math": [ "u_setup != 1" ] },
            "effect": [
              { "math": [ "_zauropod_uid = rand(1200)" ] },
              { "math": [ "u_zauropod_uid = _zauropod_uid" ] },
              { "math": [ "u_setup = 1" ] },
              { "u_spawn_monster": "mon_zauropod_leg", "real_count": 4, "min_radius": 1, "max_radius": 1 },
              {
                "u_run_monster_eocs": [ { "id": "zoabosaurus_leg_assign", "effect": [ { "math": [ "u_zauropod_id = _zauropod_uid" ] } ] } ],
                "monster_range": 2,
                "mtype_ids": [ "mon_zauropod_leg" ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "eoc_update_zoabosaurus",
    "type": "effect_on_condition",
    "global": true,
    "condition": { "math": [ "u_monsters_nearby('mon_zoabosaurus', 'radius': 3) >= 1" ] },
    "effect": [
      { "math": [ "updating_zoabosaurus = 1" ] },
      { "run_eocs": "eoc_update_zoabosaurus", "time_in_future": 1 },
      { "u_run_monster_eocs": [ "eoc_zauropod" ], "monster_range": 3, "mtype_ids": [ "mon_zoabosaurus" ] }
    ],
    "false_effect": [ { "math": [ "updating_zoabosaurus = 0" ] } ]
  },
