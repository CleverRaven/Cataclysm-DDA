    "shape": "blast",
    "min_range": 1,
    "max_range": 1,
    "message": "",
    "effect": "effect_on_condition",
    "effect_str": "EOC_MOABOSAURUS_CONTROL"
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_MOABOSAURUS_CONTROL",
    "effect": [
      {
        "run_eocs": [
          {
            "id": "eoc_start_update_moabosaurus",
            "condition": { "math": [ "updating_moabosaurus != 1" ] },
            "effect": [ { "run_eocs": "eoc_update_moabosaurus" } ]
          },
          {
            "id": "moabosaurus_setup",
            "condition": { "math": [ "u_setup != 1" ] },
            "effect": [
              { "math": [ "_sauropod_uid = rand(1200)" ] },
              { "math": [ "u_sauropod_uid = _sauropod_uid" ] },
              { "math": [ "u_setup = 1" ] },
              { "u_spawn_monster": "mon_sauropod_leg", "real_count": 4, "min_radius": 1, "max_radius": 1 },
              {
                "u_run_monster_eocs": [ { "id": "moabosaurus_leg_assign", "effect": [ { "math": [ "u_sauropod_id = _sauropod_uid" ] } ] } ],
                "monster_range": 2,
                "mtype_ids": [ "mon_sauropod_leg" ]
              }
            ]
          }
        ]
      }
    ]
  },
  {
    "id": "eoc_update_moabosaurus",
    "type": "effect_on_condition",
    "global": true,
    "condition": { "math": [ "u_monsters_nearby('mon_moabosaurus', 'radius': 3) >= 1" ] },
    "effect": [
      { "math": [ "updating_moabosaurus = 1" ] },
      { "run_eocs": "eoc_update_moabosaurus", "time_in_future": 1 },
      { "u_run_monster_eocs": [ "eoc_sauropod" ], "monster_range": 3, "mtype_ids": [ "mon_moabosaurus" ] }
    ],
    "false_effect": [ { "math": [ "updating_moabosaurus = 0" ] } ]
  },
