[
  {
    "type": "effect_on_condition",
    "id": "EOC_PYROKIN_INTENSIFY_FLAMES",
    "effect": [
      {
        "u_query_tile": "line_of_sight",
        "range": {
          "math": [
            "clamp( ( ( ( (u_spell_level('pyrokinetic_intensify_flames') + u_spell_level('pyrokinetic_intensify_flames_knack') ) * 1.1) + 3) * psionic_power_modifiers() ), 1, 70)"
          ]
        },
        "message": "Choose target.",
        "z_level": true,
        "target_var": { "context_val": "pyrokin_intensify_flames_target" }
      },
      {
        "if": { "map_field_id": "fd_fire", "loc": { "context_val": "pyrokin_intensify_flames_target" } },
        "then": [
          {
            "u_set_field": "fd_fire",
            "radius": 0,
            "intensity": 1,
            "target_var": { "context_val": "pyrokin_intensify_flames_target" }
          }
        ]
      },
      {
        "u_cast_spell": { "id": "pyrokinetic_intensify_flames_target_creature" },
        "loc": { "context_val": "pyrokin_intensify_flames_target" }
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PYROKIN_CAUTERIZE_SELECTOR",
    "effect": [
      {
        "u_pick_bodypart": { "u_val": "pyrokin_cauterize_picked_bodypart" },
        "title": "Select body part to cauterize.",
        "blacklist_flag": "BIONIC_LIMB"
      },
      {
        "if": { "u_has_effect": "bleed", "bodypart": { "u_val": "pyrokin_cauterize_picked_bodypart" } },
        "then": {
          "if": {
            "or": [ { "u_has_trait": "PROF_MED" }, { "roll_contested": { "math": [ "u_skill('firstaid')" ] }, "difficulty": 7 } ]
          },
          "then": [
            {
              "u_message": "There is a moment of searing pain, and when you look at the wound, The bleeding has stopped.",
              "type": "good"
            },
            {
              "u_add_effect": "effect_psi_post_cauterize",
              "duration": { "math": [ "rand(10800) + 3600" ] },
              "target_part": { "u_val": "pyrokin_cauterize_picked_bodypart" },
              "intensity": { "math": [ "u_effect_intensity('effect_psi_post_cauterize', 'bodypart': u_pyrokin_cauterize_picked_bodypart) + 1" ] }
            },
            { "u_lose_effect": "bleed", "target_part": { "u_val": "pyrokin_cauterize_picked_bodypart" } },
            { "math": [ "u_hp(u_pyrokin_cauterize_picked_bodypart) -= 1" ] },
            { "math": [ "u_pain('type': 'perceived') += rng(1,2)" ] },
            {
              "run_eocs": "EOC_PYROKIN_CAUTERIZE_BODYPART_INFECTION_CHECK",
              "time_in_future": [ "6 hours", "24 hours" ]
            }
          ],
          "else": [
            {
              "u_message": "There is a moment of searing pain, but when you look at the wound, you're still bleeding.  You'll have to try again.",
              "type": "bad"
            },
            {
              "u_add_effect": "effect_psi_post_cauterize",
              "duration": { "math": [ "rand(10800) + 3600" ] },
              "target_part": { "u_val": "pyrokin_cauterize_picked_bodypart" },
              "intensity": { "math": [ "u_effect_intensity('effect_psi_post_cauterize', 'bodypart': u_pyrokin_cauterize_picked_bodypart) + 1" ] }
            },
            { "math": [ "u_hp(u_pyrokin_cauterize_picked_bodypart) -= 3" ] },
            { "math": [ "u_pain('type': 'perceived') += rng(1,3)" ] },
            {
              "run_eocs": "EOC_PYROKIN_CAUTERIZE_BODYPART_INFECTION_CHECK",
              "time_in_future": [ "6 hours", "24 hours" ]
            }
          ]
        },
        "else": { "u_message": "That part isn't bleeding, cauterizing it would be pointless.", "type": "good" }
      }
    ],
    "false_effect": [ { "u_message": "You have no bleeding wounds to cauterize.", "type": "good" } ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PYROKIN_CAUTERIZE_BODYPART_INFECTION_CHECK",
    "condition": { "x_in_y_chance": { "x": 1, "y": 15 } },
    "effect": [
      {
        "run_eocs": [
          {
            "id": "EOC_PYROKIN_CAUTERIZE_BODYPART_INFECTION_CHECK_2",
            "condition": { "math": [ "u_effect_intensity('infected', 'bodypart': u_pyrokin_cauterize_picked_bodypart) >= 1" ] },
            "effect": [
              {
                "u_add_effect": "infected",
                "duration": "PERMANENT",
                "target_part": { "u_val": "pyrokin_cauterize_picked_bodypart" },
                "intensity": { "math": [ "u_effect_intensity('infected', 'bodypart': u_pyrokin_cauterize_picked_bodypart) + 1" ] }
              },
              {
                "u_message": "The infection on your <u_val:pyrokin_cauterize_picked_bodypart> is getting worse.",
                "type": "bad"
              }
            ],
            "false_effect": [
              {
                "u_add_effect": "infected",
                "duration": "PERMANENT",
                "target_part": { "u_val": "pyrokin_cauterize_picked_bodypart" },
                "intensity": 1
              },
              {
                "u_message": "The wound on your <u_val:pyrokin_cauterize_picked_bodypart> you tried to cauterize is starting to itch and swell.  It's probably infected.",
                "type": "bad"
              }
            ]
          }
        ]
      }
    ]
  },
