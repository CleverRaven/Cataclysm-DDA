          [ "EOC_assassinmission1", { "global_val": "hardmissions", "default": 0 } ],
          [ "EOC_assassinmission2", { "global_val": "hardermissions", "default": 0 } ],
          [ "EOC_assassinmission3", { "global_val": "hardestmissions", "default": 0 } ]
        ]
      }
    ]
  },
