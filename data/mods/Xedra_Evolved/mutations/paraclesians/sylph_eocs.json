    "effect": [
      {
        "math": [
          "_duration_lower_bound = ( 204.85 + (u_spell_count('school': 'SYLPH') * 67.12) + (u_skill('gramarye') * 97.85) ) * scaling_factor(u_val('perception') )"
        ]
      },
      {
        "math": [
          "_duration_upper_bound = ( 398.55 + (u_spell_count('school': 'SYLPH') * 102.35) + (u_skill('gramarye') * 218.53) ) * scaling_factor(u_val('perception') )"
        ]
      },
      { "math": [ "_duration = rng(_duration_lower_bound, _duration_upper_bound)" ] },
      {
        "switch": { "math": [ "u_spell_count('school': 'SYLPH') " ] },
        "cases": [
          {
            "case": 0,
            "effect": [ { "u_add_effect": "effect_paraclesian_dodge_bonus_1", "duration": { "math": [ "_duration" ] } } ]
          },
          {
            "case": 15,
            "effect": [ { "u_add_effect": "effect_paraclesian_dodge_bonus_2", "duration": { "math": [ "_duration" ] } } ]
          },
          {
            "case": 25,
            "effect": [ { "u_add_effect": "effect_paraclesian_dodge_bonus_3", "duration": { "math": [ "_duration" ] } } ]
          }
        ]
      }
    ]
  },
