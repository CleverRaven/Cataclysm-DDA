    "effect": [
      {
        "math": [
          "_glamour_min_duration = ( ( ( 172848.61 + (u_spell_count('school': 'CHANGELING_SEASONAL_MAGIC_SPRING') * 5184.31) + (u_skill('gramarye') * 29413.51) ) ) * (global_what_is_the_season == 3 ? 0.4 : 1) )"
        ]
      },
      {
        "math": [
          "_glamour_max_duration = ( ( ( 483844.89 + (u_spell_count('school': 'CHANGELING_SEASONAL_MAGIC_SPRING') * 15861.23) + (u_skill('gramarye') * 45945.12) ) ) * (global_what_is_the_season == 3 ? 0.4 : 1) )"
        ]
      },
      {
        "u_add_effect": "effect_changeling_spring_turn_target_into_tree",
        "duration": { "math": [ "rng(_glamour_min_duration, _glamour_max_duration)" ] }
      },
      { "u_add_trait": "CHANGELING_SPRING_TURN_INTO_TREE_TRACKER" }
    ],
    "false_effect": [
      { "u_lose_effect": "effect_changeling_spring_turn_target_into_tree" },
