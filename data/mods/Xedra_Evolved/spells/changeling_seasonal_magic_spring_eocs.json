        ]
      },
      {
        "math": [
          "u_spell_high_duration = ( ( 1685.24 + (n_spell_count('school': 'CHANGELING_SEASONAL_MAGIC_SPRING') * 348.15) + (n_skill('gramarye') * 498.51) ) )"
        ]
      },
