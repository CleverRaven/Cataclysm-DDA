        ]
      },
      {
        "math": [
          "u_spell_high_duration = ( ( 1685.24 + (u_spell_count('school': 'CHANGELING_SEASONAL_MAGIC_SPRING') * 348.15) + (u_skill('gramarye') * 498.51) ) )"
        ]
